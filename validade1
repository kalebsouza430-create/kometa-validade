      <p id="form-message" class="hidden rounded-xl px-3 py-2 text-sm font-medium" role="status"></p><button id="save-product-button" data-template-id="save-product-button" type="submit" class="canva-button mt-1 inline-flex w-full items-center justify-center gap-2 rounded-xl px-4 py-4 font-bold shadow-sm transition hover:brightness-95" style="background: rgb(38, 115, 77); color: rgb(255, 255, 255); font-weight: 700;"> <i data-lucide="save" class="h-5 w-5" aria-hidden="true"></i> <span data-template-id="save-product-text" class="canva-text" style="color: rgb(255, 255, 255); font-weight: 700; font-style: normal; font-size: 16px;">Salvar produto</span> </button>
     </div>
    </form>
